rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Auth foundation + Member 2 Discovery iteration 1.
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function activeUser() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isEventManager() {
      return activeUser()
        && (currentRole() == 'organizer' || currentRole() == 'admin');
    }
    function isAdmin() {
      return isEventManager() && currentRole() == 'admin';
    }
    function validEventFields(data) {
      return data.keys().hasAll([
          'organizerId', 'clubId', 'title', 'titleLower', 'description',
          'category', 'locationName', 'latitude', 'longitude', 'startAt',
          'endAt', 'capacity', 'registeredCount', 'checkedInCount',
          'posterUrl', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'organizerId', 'clubId', 'title', 'titleLower', 'description',
          'category', 'locationName', 'latitude', 'longitude', 'startAt',
          'endAt', 'capacity', 'registeredCount', 'checkedInCount',
          'posterUrl', 'status', 'createdAt', 'updatedAt'
        ])
        && data.organizerId is string
        && (data.clubId == null || data.clubId is string)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.titleLower is string
        && data.description is string && data.description.size() >= 20
        && data.category in ['technology', 'sport', 'workshop', 'music']
        && data.locationName is string && data.locationName.size() > 0
        && (data.latitude == null || data.latitude is number)
        && (data.longitude == null || data.longitude is number)
        && data.startAt is timestamp && data.endAt is timestamp
        && data.startAt < data.endAt
        && data.capacity is int && data.capacity > 0 && data.capacity <= 5000
        && data.registeredCount is int && data.registeredCount >= 0
        && data.registeredCount <= data.capacity
        && data.checkedInCount is int && data.checkedInCount >= 0
        && data.checkedInCount <= data.registeredCount
        && (data.posterUrl == null || data.posterUrl is string)
        && data.status in ['draft', 'published', 'cancelled', 'finished']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /events/{eventId} {
      // Discovery queries must include status == published.
      allow read: if activeUser() && (
        resource.data.status == 'published'
        || (isEventManager() && (
          isAdmin() || resource.data.organizerId == request.auth.uid
        ))
      );
      allow create: if isEventManager()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.registeredCount == 0
        && request.resource.data.checkedInCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validEventFields(request.resource.data);
      allow update: if isEventManager()
        && (isAdmin() || resource.data.organizerId == request.auth.uid)
        && request.resource.data.organizerId == resource.data.organizerId
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.posterUrl == resource.data.posterUrl
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude
        && request.resource.data.registeredCount == resource.data.registeredCount
        && request.resource.data.checkedInCount == resource.data.checkedInCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validEventFields(request.resource.data)
        && (
          (resource.data.status != 'cancelled'
            && request.resource.data.status == resource.data.status)
          || (request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']))
        );
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'avatarUrl',
          'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'avatarUrl',
          'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.avatarUrl == null
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Profile updates, status changes and role assignment are future work.
      allow list, update, delete: if false;
    }
    match /registrations/{registrationId} {
      allow read: if activeUser() && (
        resource.data.userId == request.auth.uid
        || isEventManager()
      );
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid;
      allow update: if activeUser() && (
        resource.data.userId == request.auth.uid
        || isEventManager()
      );
      allow delete: if false;
    }
    match /clubs/{clubId} {
      allow read: if activeUser() && (
        resource.data.status == 'active' || isEventManager()
      );
      allow create: if isEventManager()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.memberCount == 0;
      allow update: if isAdmin() || (
        isEventManager() && resource.data.ownerId == request.auth.uid
      ) || (
        activeUser()
        && currentRole() == 'student'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberCount', 'updatedAt'])
        && request.resource.data.memberCount >= 0
      );
      allow delete: if false;
    }
    match /club_memberships/{membershipId} {
      allow read: if activeUser() && (
        resource.data.userId == request.auth.uid || isEventManager()
      );
      allow create: if activeUser() && (
        request.resource.data.userId == request.auth.uid
        || isEventManager()
      );
      allow update: if activeUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.clubId == resource.data.clubId;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
