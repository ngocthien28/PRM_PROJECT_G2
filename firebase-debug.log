[debug] [2026-10-12T15:46:41.145Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/studio-1527538381-9d991/rulesets {"name":"projects/studio-1527538381-9d991/rulesets/5f0b845f-6126-40bf-9d68-294fb36406ab","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // Auth foundation + Member 2 Discovery iteration 1.\r\n    function owns(uid) {\r\n      return request.auth != null && request.auth.uid == uid;\r\n    }\r\n    function activeUser() {\r\n      return request.auth != null\r\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';\r\n    }\r\n    function currentRole() {\r\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;\r\n    }\r\n    function isEventManager() {\r\n      return activeUser()\r\n        && (currentRole() == 'organizer' || currentRole() == 'admin');\r\n    }\r\n    function isAdmin() {\r\n      return isEventManager() && currentRole() == 'admin';\r\n    }\r\n    function validEventFields(data) {\r\n      return data.keys().hasAll([\r\n          'organizerId', 'clubId', 'title', 'titleLower', 'description',\r\n          'category', 'locationName', 'latitude', 'longitude', 'startAt',\r\n          'endAt', 'capacity', 'registeredCount', 'checkedInCount',\r\n          'posterUrl', 'status', 'createdAt', 'updatedAt'\r\n        ])\r\n        && data.keys().hasOnly([\r\n          'organizerId', 'clubId', 'title', 'titleLower', 'description',\r\n          'category', 'locationName', 'latitude', 'longitude', 'startAt',\r\n          'endAt', 'capacity', 'registeredCount', 'checkedInCount',\r\n          'posterUrl', 'status', 'createdAt', 'updatedAt'\r\n        ])\r\n        && data.organizerId is string\r\n        && (data.clubId == null || data.clubId is string)\r\n        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120\r\n        && data.titleLower is string\r\n        && data.description is string && data.description.size() >= 20\r\n        && data.category in ['technology', 'sport', 'workshop', 'music']\r\n        && data.locationName is string && data.locationName.size() > 0\r\n        && (data.latitude == null || data.latitude is number)\r\n        && (data.longitude == null || data.longitude is number)\r\n        && data.startAt is timestamp && data.endAt is timestamp\r\n        && data.startAt < data.endAt\r\n        && data.capacity is int && data.capacity > 0 && data.capacity <= 5000\r\n        && data.registeredCount is int && data.registeredCount >= 0\r\n        && data.registeredCount <= data.capacity\r\n        && data.checkedInCount is int && data.checkedInCount >= 0\r\n        && data.checkedInCount <= data.registeredCount\r\n        && (data.posterUrl == null || data.posterUrl is string)\r\n        && data.status in ['draft', 'published', 'cancelled', 'finished']\r\n        && data.createdAt is timestamp && data.updatedAt is timestamp;\r\n    }\r\n    match /events/{eventId} {\r\n      // Discovery queries must include status == published.\r\n      allow read: if activeUser() && (\r\n        resource.data.status == 'published'\r\n        || (isEventManager() && (\r\n          isAdmin() || resource.data.organizerId == request.auth.uid\r\n        ))\r\n      );\r\n      allow create: if isEventManager()\r\n        && request.resource.data.organizerId == request.auth.uid\r\n        && request.resource.data.status == 'published'\r\n        && request.resource.data.registeredCount == 0\r\n        && request.resource.data.checkedInCount == 0\r\n        && request.resource.data.createdAt == request.time\r\n        && request.resource.data.updatedAt == request.time\r\n        && validEventFields(request.resource.data);\r\n      allow update: if isEventManager()\r\n        && (isAdmin() || resource.data.organizerId == request.auth.uid)\r\n        && request.resource.data.organizerId == resource.data.organizerId\r\n        && request.resource.data.clubId == resource.data.clubId\r\n        && request.resource.data.posterUrl == resource.data.posterUrl\r\n        && request.resource.data.latitude == resource.data.latitude\r\n        && request.resource.data.longitude == resource.data.longitude\r\n        && request.resource.data.registeredCount == resource.data.registeredCount\r\n        && request.resource.data.checkedInCount == resource.data.checkedInCount\r\n        && request.resource.data.createdAt == resource.data.createdAt\r\n        && request.resource.data.updatedAt == request.time\r\n        && validEventFields(request.resource.data)\r\n        && (\r\n          (resource.data.status != 'cancelled'\r\n            && request.resource.data.status == resource.data.status)\r\n          || (request.resource.data.status == 'cancelled'\r\n            && request.resource.data.diff(resource.data).affectedKeys()\r\n              .hasOnly(['status', 'updatedAt']))\r\n        );\r\n      allow delete: if false;\r\n    }\r\n    match /users/{uid} {\r\n      allow get: if owns(uid);\r\n      allow create: if owns(uid)\r\n        && request.resource.data.keys().hasAll([\r\n          'uid', 'email', 'displayName', 'avatarUrl',\r\n          'role', 'status', 'createdAt', 'updatedAt'\r\n        ])\r\n        && request.resource.data.keys().hasOnly([\r\n          'uid', 'email', 'displayName', 'avatarUrl',\r\n          'role', 'status', 'createdAt', 'updatedAt'\r\n        ])\r\n        && request.resource.data.uid == uid\r\n        && request.resource.data.email is string\r\n        && request.resource.data.displayName is string\r\n        && request.resource.data.displayName.size() >= 2\r\n        && request.resource.data.displayName.size() <= 50\r\n        && request.resource.data.avatarUrl == null\r\n        && request.resource.data.role == 'student'\r\n        && request.resource.data.status == 'active'\r\n        && request.resource.data.createdAt == request.time\r\n        && request.resource.data.updatedAt == request.time;\r\n      // Profile updates, status changes and role assignment are future work.\r\n      allow list, update, delete: if false;\r\n    }\r\n    match /registrations/{registrationId} {\r\n      allow read: if activeUser() && (\r\n        resource.data.userId == request.auth.uid\r\n        || isEventManager()\r\n      );\r\n      allow create: if activeUser()\r\n        && request.resource.data.userId == request.auth.uid;\r\n      allow update: if activeUser() && (\r\n        resource.data.userId == request.auth.uid\r\n        || isEventManager()\r\n      );\r\n      allow delete: if false;\r\n    }\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-12T15:46:40.177855Z","metadata":{"services":["cloud.firestore"]}}
