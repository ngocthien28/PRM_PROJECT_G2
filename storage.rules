rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }
    function isEventManager() {
      return isSignedIn() && (
        request.auth.token.role == 'organizer'
        || request.auth.token.role == 'admin'
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['organizer', 'admin']
      );
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin'
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Staging / Organizer-scoped path: posters/{userId}/{fileName}
    match /posters/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if (isOwner(userId) || isAdmin())
        && isEventManager()
        && isValidImage();
      allow delete: if (isOwner(userId) || isAdmin()) && isEventManager();
    }

    // Event-specific path: events/{eventId}/{fileName}
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow create, update: if isEventManager()
        && (fileName.matches(request.auth.uid + '_.*') || isAdmin())
        && isValidImage();
      allow delete: if isEventManager()
        && (fileName.matches(request.auth.uid + '_.*') || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
