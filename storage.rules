rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }
    function isEventManager() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['organizer', 'admin'];
    }
    function isAdmin() {
      return isEventManager()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function managesEvent(eventId) {
      return isEventManager()
        && firestore.exists(/databases/(default)/documents/events/$(eventId))
        && (isAdmin()
          || firestore.get(/databases/(default)/documents/events/$(eventId)).data.organizerId == request.auth.uid);
    }

    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Staging / Organizer-scoped path: posters/{userId}/{fileName}
    match /posters/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if (isOwner(userId) || isAdmin())
        && isEventManager()
        && isValidImage();
      allow delete: if (isOwner(userId) || isAdmin()) && isEventManager();
    }

    // Event-specific path: ownership comes from the event, never a filename.
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow create, update: if managesEvent(eventId)
        && firestore.get(/databases/(default)/documents/events/$(eventId)).data.status != 'cancelled'
        && isValidImage();
      allow delete: if managesEvent(eventId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
