rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Auth foundation + Member 2 Discovery iteration 1.
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function activeUser() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    match /events/{eventId} {
      // Discovery queries must include status == published.
      allow read: if activeUser() && resource.data.status == 'published';
      // Organizer writes will be added by the owning module.
      allow write: if false;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'avatarUrl',
          'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'avatarUrl',
          'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.avatarUrl == null
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Profile updates, status changes and role assignment are future work.
      allow list, update, delete: if false;
    }
    match /registrations/{registrationId} {
      allow read: if activeUser() && (
        resource.data.userId == request.auth.uid
        || isEventManager()
      );
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid;
      allow update: if activeUser() && (
        resource.data.userId == request.auth.uid
        || isEventManager()
      );
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
