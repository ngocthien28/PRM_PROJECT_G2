rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Auth foundation + Member 2 Discovery iteration 1.
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return request.auth != null
        && userDoc().status == 'active';
    }
    function currentRole() {
      return userDoc().role;
    }
    function isEventManager() {
      return activeUser()
        && (currentRole() == 'organizer' || currentRole() == 'admin');
    }
    function isAdmin() {
      return activeUser() && currentRole() == 'admin';
    }
    function isStudent() {
      return activeUser() && currentRole() == 'student';
    }
    function managesEvent(eventId) {
      return isEventManager() && (isAdmin()
        || get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid);
    }
    function validEventFields(data) {
      return data.keys().hasAll([
          'organizerId', 'clubId', 'title', 'titleLower', 'description',
          'category', 'locationName', 'latitude', 'longitude', 'startAt',
          'endAt', 'capacity', 'registeredCount', 'checkedInCount',
          'posterUrl', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'organizerId', 'clubId', 'title', 'titleLower', 'description',
          'category', 'locationName', 'latitude', 'longitude', 'startAt',
          'endAt', 'capacity', 'registeredCount', 'checkedInCount',
          'posterUrl', 'status', 'createdAt', 'updatedAt', 'lastCheckInRegistrationId'
        ])
        && data.organizerId is string
        && (data.clubId == null || data.clubId is string)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.title == data.title.trim()
        && data.titleLower == data.title.lower()
        && data.description is string && data.description.size() >= 20
        && data.description == data.description.trim()
        && data.category in ['technology', 'sport', 'workshop', 'music']
        && data.locationName is string && data.locationName.size() > 0
        && data.locationName == data.locationName.trim()
        && (data.latitude == null || data.latitude is number)
        && (data.longitude == null || data.longitude is number)
        && data.startAt is timestamp && data.endAt is timestamp
        && data.startAt < data.endAt
        && data.capacity is int && data.capacity > 0 && data.capacity <= 5000
        && data.registeredCount is int && data.registeredCount >= 0
        && data.registeredCount <= data.capacity
        && data.checkedInCount is int && data.checkedInCount >= 0
        && data.checkedInCount <= data.registeredCount
        && (data.posterUrl == null || data.posterUrl is string)
        && data.status in ['draft', 'published', 'cancelled', 'finished']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (data.get('lastCheckInRegistrationId', null) == null
          || data.lastCheckInRegistrationId is string);
    }
    // Attach URLs only as active owner/admin. Cloudinary unsigned upload itself
    // is public; Rules enforce event ownership and the delivery account/path.
    function validPosterUrl(eventId, url) {
      let objectPath = '/v0/b/[^/]+/o/events%2F' + eventId
        + '%2F[A-Za-z0-9_-]+[.](jpg|png|webp)[?]alt=media&token=[A-Za-z0-9,-]+';
      return eventId.matches('[A-Za-z0-9_-]+') && url is string && url.size() <= 2048
        && (url.matches('https://res[.]cloudinary[.]com/djznx3z7o/image/upload/v[0-9]+/'
            + '(campushub/club_logos/)?campushub/event_posters/' + eventId
            + '/[A-Za-z0-9_-]+[.](jpg|jpeg|png|webp)')
          || url.matches('https://firebasestorage[.]googleapis[.]com' + objectPath)
          || url.matches('http://(127[.]0[.]0[.]1|localhost):9199' + objectPath));
    }
    function validRegistration(data, registrationId) {
      return data.keys().hasAll(['eventId', 'userId', 'status', 'qrToken',
          'registeredAt', 'cancelledAt', 'checkedInAt'])
        && data.keys().hasOnly(['eventId', 'userId', 'status', 'qrToken',
          'registeredAt', 'cancelledAt', 'checkedInAt'])
        && data.eventId is string && data.eventId.size() > 0
        && data.userId is string && data.userId.size() > 0
        && registrationId == data.eventId + '_' + data.userId
        && data.status in ['registered', 'cancelled', 'checkedIn']
        && data.qrToken is string && data.qrToken.size() > 0 && data.qrToken.size() <= 1024
        && data.registeredAt is timestamp
        && (data.cancelledAt == null || data.cancelledAt is timestamp)
        && (data.checkedInAt == null || data.checkedInAt is timestamp);
    }
    function mayJoin(eventId, registrationId) {
      let path = /databases/$(database)/documents/registrations/$(registrationId);
      return !exists(path) || (get(path).data.status == 'cancelled'
        && get(path).data.checkedInAt == null
        && get(path).data.userId == request.auth.uid
        && get(path).data.eventId == eventId);
    }
    function joinedAtomically(eventId, beforeEvent, afterEvent) {
      let rid = eventId + '_' + request.auth.uid;
      let afterReg = getAfter(/databases/$(database)/documents/registrations/$(rid)).data;
      return beforeEvent.status == 'published' && beforeEvent.startAt > request.time
        && beforeEvent.registeredCount < beforeEvent.capacity
        && afterEvent.registeredCount == beforeEvent.registeredCount + 1
        && afterEvent.diff(beforeEvent).affectedKeys().hasOnly(['registeredCount', 'updatedAt'])
        && afterEvent.updatedAt == request.time
        && mayJoin(eventId, rid)
        && afterReg.userId == request.auth.uid && afterReg.eventId == eventId
        && afterReg.status == 'registered' && afterReg.registeredAt == request.time
        && afterReg.checkedInAt == null && afterReg.cancelledAt == null;
    }
    function cancelledAtomically(eventId, beforeEvent, afterEvent) {
      let rid = eventId + '_' + request.auth.uid;
      let path = /databases/$(database)/documents/registrations/$(rid);
      let beforeReg = get(path).data;
      let afterReg = getAfter(path).data;
      return beforeReg.userId == request.auth.uid && beforeReg.eventId == eventId
        && beforeReg.status == 'registered' && beforeReg.checkedInAt == null
        && request.time <= beforeEvent.startAt - duration.value(2, 'h')
        && beforeEvent.registeredCount > 0
        && afterEvent.registeredCount == beforeEvent.registeredCount - 1
        && afterEvent.diff(beforeEvent).affectedKeys().hasOnly(['registeredCount', 'updatedAt'])
        && afterEvent.updatedAt == request.time
        && afterReg.diff(beforeReg).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && afterReg.status == 'cancelled' && afterReg.cancelledAt == request.time;
    }
    function checkedInAtomically(eventId, registrationId, beforeEvent, afterEvent) {
      let path = /databases/$(database)/documents/registrations/$(registrationId);
      let beforeReg = get(path).data;
      let afterReg = getAfter(path).data;
      return managesEvent(eventId) && beforeEvent.status == 'published'
        && beforeReg.eventId == eventId && beforeReg.status == 'registered'
        && beforeReg.checkedInAt == null
        && validRegistration(afterReg, registrationId)
        && afterReg.diff(beforeReg).affectedKeys().hasOnly(['status', 'checkedInAt'])
        && afterReg.status == 'checkedIn' && afterReg.checkedInAt == request.time
        && afterEvent.checkedInCount == beforeEvent.checkedInCount + 1
        && afterEvent.diff(beforeEvent).affectedKeys()
          .hasOnly(['checkedInCount', 'updatedAt', 'lastCheckInRegistrationId'])
        && afterEvent.lastCheckInRegistrationId == registrationId
        && afterEvent.updatedAt == request.time;
    }
    match /events/{eventId} {
      // Discovery queries must include status == published.
      allow read: if activeUser() && (
        resource.data.status == 'published'
        || (isEventManager() && (
          isAdmin() || resource.data.organizerId == request.auth.uid
        ))
      );
      // Registered students may still read the event for cancellation/history.
      // This is get-only; it does not broaden discovery list queries.
      allow get: if activeUser()
        && exists(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid));
      allow create: if isEventManager()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.startAt > request.time
        && request.resource.data.registeredCount == 0
        && request.resource.data.checkedInCount == 0
        && request.resource.data.posterUrl == null
        && request.resource.data.get('lastCheckInRegistrationId', null) == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validEventFields(request.resource.data);
      allow update: if isEventManager()
        && (isAdmin() || resource.data.organizerId == request.auth.uid)
        && request.resource.data.organizerId == resource.data.organizerId
        && request.resource.data.clubId == resource.data.clubId
        && (request.resource.data.posterUrl == resource.data.posterUrl
          || validPosterUrl(eventId, request.resource.data.posterUrl))
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude
        && request.resource.data.registeredCount == resource.data.registeredCount
        && request.resource.data.checkedInCount == resource.data.checkedInCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validEventFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'titleLower', 'description', 'category', 'locationName',
          'startAt', 'endAt', 'capacity', 'status', 'updatedAt', 'posterUrl'
        ])
        && (
          (resource.data.status != 'cancelled'
            && request.resource.data.status == resource.data.status)
          || (request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']))
        );
      allow update: if isStudent()
        && (joinedAtomically(eventId, resource.data, request.resource.data)
          || cancelledAtomically(eventId, resource.data, request.resource.data));
      allow update: if isEventManager()
        && request.resource.data.get('lastCheckInRegistrationId', null) is string
        && checkedInAtomically(eventId, request.resource.data.lastCheckInRegistrationId,
          resource.data, request.resource.data);
      allow delete: if false;
    }
    match /users/{uid} {
      match /device_tokens/{tokenId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && activeUser()
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() < 1024
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt == request.time;
      }
      match /favorites/{eventId} {
        allow read, write: if owns(uid) && activeUser();
      }
      allow get: if owns(uid) || isEventManager();
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'avatarUrl',
          'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'avatarUrl',
          'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.avatarUrl == null
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow list: if isAdmin();
      allow update: if owns(uid) && activeUser()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'avatarUrl', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'avatarUrl', 'phone', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50
        && (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string)
        && (!('phone' in request.resource.data) || request.resource.data.phone == null
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 24))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatarUrl', 'phone', 'updatedAt'
        ]);
      allow delete: if false;
    }
    match /registrations/{registrationId} {
      allow read: if activeUser() && (
        resource.data.userId == request.auth.uid
        || managesEvent(resource.data.eventId)
      );
      // joinEvent reads its deterministic document before the first create.
      allow get: if isStudent()
        && !exists(/databases/$(database)/documents/registrations/$(registrationId))
        && registrationId.matches('.*_' + request.auth.uid);
      allow create: if isStudent()
        && validRegistration(request.resource.data, registrationId)
        && request.resource.data.userId == request.auth.uid
        && joinedAtomically(request.resource.data.eventId,
             get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data,
             getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data);
      allow update: if isStudent()
        && validRegistration(request.resource.data, registrationId)
        && request.resource.data.userId == request.auth.uid
        && (cancelledAtomically(request.resource.data.eventId,
             get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data,
             getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data)
           || joinedAtomically(request.resource.data.eventId,
             get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data,
             getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data));
      allow update: if isEventManager()
        && checkedInAtomically(resource.data.eventId, registrationId,
          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data,
          getAfter(/databases/$(database)/documents/events/$(resource.data.eventId)).data);
      allow delete: if false;
    }
    match /clubs/{clubId} {
      allow read: if activeUser() && (
        resource.data.status == 'active' || isEventManager()
      );
      allow create: if isEventManager()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.memberCount == 0;
      allow update: if isAdmin() || (
        isEventManager() && resource.data.ownerId == request.auth.uid
      ) || (
        activeUser()
        && currentRole() == 'student'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberCount', 'updatedAt'])
        && request.resource.data.memberCount >= 0
      );
      allow delete: if false;
    }
    match /club_memberships/{membershipId} {
      // A join transaction must read the deterministic membership document
      // before it exists. In that case resource.data is unavailable, so use
      // the `{clubId}_{uid}` document ID to authorize the owner lookup.
      allow get: if activeUser() && (
        membershipId.matches('.*_' + request.auth.uid)
        || isEventManager()
      );
      allow list: if activeUser() && (
        resource.data.userId == request.auth.uid || isEventManager()
      );
      allow create: if activeUser() && (
        request.resource.data.userId == request.auth.uid
        || isEventManager()
      );
      allow update: if activeUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.clubId == resource.data.clubId;
      allow delete: if false;
    }
    match /notifications/{notificationId} {
      allow read: if activeUser() && resource.data.userId == request.auth.uid;
      // Join/Leave creates an inbox entry in the same atomic transaction.
      allow create: if activeUser() && currentRole() == 'student'
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'body', 'type', 'referenceId', 'membershipStatus',
          'isRead', 'createdAt', 'pushStatus'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type == 'club_membership'
        && request.resource.data.referenceId is string
        && request.resource.data.membershipStatus in ['active', 'left']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.isRead == false
        && request.resource.data.pushStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/club_memberships/$(request.resource.data.referenceId + '_' + request.auth.uid)).data.status == request.resource.data.membershipStatus
        && getAfter(/databases/$(database)/documents/club_memberships/$(request.resource.data.referenceId + '_' + request.auth.uid)).data.updatedAt == request.time;
      allow update: if activeUser() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;
      allow delete: if false;
    }
    match /moderation_cases/{caseId} {
      allow read: if isAdmin();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'targetType', 'targetId', 'title', 'description', 'reporterId',
          'reporterName', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['club', 'event', 'user', 'other']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolutionAction', 'resolution', 'resolvedBy',
          'resolvedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['resolved', 'dismissed']
        && request.resource.data.resolutionAction in ['resolve', 'dismiss']
        && request.resource.data.resolution is string
        && request.resource.data.resolution.size() >= 5
        && request.resource.data.resolution.size() <= 500
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
